{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "labels": {
      "spark-app-selector": "__APP_ID__"
    },
    "name": "__PREFIX__-driver-pvc-0",
    "ownerReferences": [
      {
        "apiVersion": "v1",
        "controller": true,
        "kind": "Pod",
        "name": "__PREFIX__-driver",
        "uid": "__OWNER_UID__"
      }
    ]
  },
  "spec": {
    "accessModes": [
      "ReadWriteOncePod"
    ],
    "resources": {
      "requests": {
        "storage": "1Gi"
      }
    },
    "storageClassName": "standard"
  }
}
